# StreamX Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!

# --- Application Configuration ---
STREAMX_ENV=development
STREAMX_SECRET_KEY=replace-with-a-random-32-byte-hex-secret
DATABASE_URL=sqlite:///./streamx.db
LOG_LEVEL=INFO

# --- Telegram Bot Ingestion ---
# Obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# --- Telegram MTProto Client (User Session for Large File Transfers) ---
# Obtained from https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# String session generated during Phase 3 interactive authentication
TELEGRAM_SESSION_STRING=

# Allowed Telegram user IDs (comma-separated). Protects your bot from unauthorized public use!
TELEGRAM_ALLOWED_USER_IDS=

# --- Google Drive Master Library ---
# Google OAuth Client Credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional root folder ID for StreamX in Drive (defaults to creating 'StreamX')
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Storage & Streaming Limits ---
# Memory buffer size per chunk during streaming upload (bytes, default 8MB)
CHUNK_BUFFER_SIZE_BYTES=8388608
# Maximum retry attempts for failed transfers
MAX_RETRIES=3

# --- TMDB Metadata Provider ---
# Obtained from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
